{
  "name": "Prospera Admin",
  "short_name": "ProsperaAdmin",
  "description": "Panel de Control Root y Gestión para Prospera Finanzas.",
  "id": "/",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "display_override": [
    "tabbed",
    "window-controls-overlay",
    "standalone",
    "minimal-ui"
  ],
  "background_color": "#0f172a",
  "theme_color": "#0f172a",
  "orientation": "portrait",
  "lang": "es",
  "dir": "ltr",
  "iarc_rating_id": "e84b072d-71b3-4d3e-86ae-31a8ec4e53b7",
  "prefer_related_applications": false,
  "related_applications": [
    {
      "platform": "play",
      "id": "com.prosperafinanzas.admin",
      "url": "https://play.google.com/store/apps/details?id=com.prosperafinanzas.admin"
    }
  ],
  "categories": [
    "finance",
    "productivity",
    "business"
  ],
  "launch_handler": {
    "client_mode": ["navigate-existing", "auto"]
  },
  "scope_extensions": [
    { "origin": "https://prosperafinanzas.com" },
    { "origin": "https://admin.prosperafinanzas.com" },
    { "origin": "https://app.prosperafinanzas.com" }
  ],
  "shortcuts": [
    {
      "name": "Dashboard Admin",
      "short_name": "Dashboard",
      "description": "Ver métricas y panel principal",
      "url": "/",
      "icons": [
        {
          "src": "/icon-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    }
  ],
  "file_handlers": [
    {
      "action": "/",
      "name": "Archivos Administrativos",
      "accept": {
        "text/csv": [".csv"],
        "application/pdf": [".pdf"]
      }
    }
  ],
  "protocol_handlers": [
    {
      "protocol": "web+prosperaadmin",
      "url": "/?action=%s"
    }
  ],
  "share_target": {
    "action": "/",
    "method": "GET",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url"
    }
  },
  "note_taking": {
    "new_note_url": "/?note=new"
  },
  "widgets": [
    {
      "name": "Prospera Admin Widget",
      "short_name": "AdminWidget",
      "description": "Panel de administración rápido",
      "tag": "prospera-admin-widget",
      "template": "widget",
      "ms_ac_template": "/widget.json",
      "data": "/widget-data.json",
      "type": "application/json",
      "screenshots": [
        {
          "src": "/screenshots/screen-mobile.png",
          "sizes": "540x1200",
          "label": "Vista de widget admin"
        }
      ]
    }
  ],
  "edge_side_panel": {
    "preferred_width": 480
  },
  "icons": [
    {
      "src": "/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "screenshots": [
    {
      "src": "/screenshots/screen-mobile.png",
      "sizes": "540x1200",
      "type": "image/png",
      "form_factor": "narrow",
      "label": "Vista móvil de Prospera Admin"
    },
    {
      "src": "/screenshots/screen-desktop.png",
      "sizes": "1280x720",
      "type": "image/png",
      "form_factor": "wide",
      "label": "Panel de Control Prospera Admin"
    }
  ]
}